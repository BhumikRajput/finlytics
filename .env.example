# --- Database ---------------------------------------------------------------
# PostgreSQL connection string (required). Examples:
#   Neon:     postgresql://user:pass@host/db?sslmode=require
#   Supabase: postgresql://postgres:pass@host:5432/postgres
#   Local:    postgresql://postgres:postgres@localhost:5432/finlytics
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Required. Generate a different value for each environment with:
#   npx auth secret   (or: openssl rand -base64 32)
# Changing it signs every user out (sessions are JWT cookies).
AUTH_SECRET=""

# On Vercel, Auth.js usually infers the public URL from the deployment.
# Production, when NOT hosted on Vercel:
# Public base URL of the app, no trailing slash.
# AUTH_URL="https://your-domain.com"
# Trust the Host / X-Forwarded-* headers from your reverse proxy
# (nginx, Caddy, ...). Only enable when the app is behind one.
# AUTH_TRUST_HOST=true

# Optional: enables the "Continue with Google" button. Leave both empty to disable.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   dev:  http://localhost:3000/api/auth/callback/google
#   prod: https://your-domain.com/api/auth/callback/google
# The OAuth consent screen must be published ("In production"), otherwise only
# listed test users can sign in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Demo account created by `npm run seed` / `npx prisma db seed` ----------
# Dev only. Do not seed a production database.
# Defaults: alex@example.com / demo12345.
# SEED_USER_EMAIL="alex@example.com"
# SEED_USER_NAME="Alex Morgan"
# SEED_USER_PASSWORD="demo12345"
