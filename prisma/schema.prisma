generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Every piece of app data belongs to a User. Users sign in through Auth.js
// (see src/auth.ts) with email + password or with Google. Sessions are JWTs, so
// there are no Session/Account tables; this table is the single source of truth.
model User {
  id            String        @id @default(cuid())
  email         String        @unique // always stored lowercase + trimmed
  name          String
  // bcrypt hash. Null for users who only ever signed in with Google.
  passwordHash  String?
  // Set when the email is proven (Google says it's verified). Password sign-ups
  // are NOT verified yet (no email flow), so this stays null for them.
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  transactions  Transaction[]
  budgets       Budget[]
  categories    Category[]
}

model Transaction {
  // Ids are generated by the client (crypto.randomUUID) or the seed ("t1"...),
  // so they are only unique per user -> composite primary key.
  id          String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  note        String   @default("")
  date        String // "yyyy-MM-dd" (kept as text: the app compares/prefix-matches it as a string)
  amountCents Int // money is stored as integer cents; signed (expenses are negative)
  type        String // "income" | "expense"
  category    String // category key, e.g. "food"
  createdAt   DateTime @default(now())

  @@id([userId, id])
  @@index([userId, date])
}

// One row per (user, month, category). A month with no rows carries forward the
// latest earlier month, same as the old budgets.json behaviour.
model Budget {
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String // "yyyy-MM"
  category    String
  amountCents Int

  @@id([userId, month, category])
}

// One row per (user, category). `value` is the stable key that Transaction.category and
// Budget.category point to ("food", "gym-membership"); `label` is the display name and
// can be renamed. There is no foreign key from Transaction/Budget, so deleting a category
// must first move its transactions and budget elsewhere (the DELETE route refuses
// otherwise). The icon is stored by name; see src/lib/category-icons.ts.
model Category {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     String // slug, matches CATEGORY_RE in src/lib/api-helpers.ts
  label     String
  kind      String // "expense" | "income"
  iconName  String // key of CATEGORY_ICONS, e.g. "UtensilsCrossed"
  iconBg    String // Tailwind class, e.g. "bg-orange-100"
  iconColor String // Tailwind class, e.g. "text-orange-500"
  color     String // chart colour: "#rrggbb" or a CSS variable such as "var(--chart-food)"
  custom    Boolean  @default(true) // false = default category: can be renamed, not deleted
  position  Int      @default(0) // display order
  createdAt DateTime @default(now())

  @@id([userId, value])
}
